<UserControl x:Class="HireMaster.ItemScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HireMaster"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" d:Background="Black">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="6*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="dgvItems" Margin="10" CanUserAddRows="False" SelectionChanged="dgvItems_SelectionChanged"/>

        <Button x:Name="btnDelete" Grid.Row="1" HorizontalAlignment="Left" Margin="10" Width="100" Click="btnDelete_Click">DELETE</Button>

        <StackPanel Grid.Column="1" Margin="10">
            <Label>Item Name</Label>
            <TextBox x:Name="txtItemName"/>
            <Label>Category</Label>
            <ComboBox x:Name="cboCategory"/>
            <Label>Description</Label>
            <TextBox x:Name="txtDescription" TextWrapping="Wrap" Height="50"/>

            <Button x:Name="btnSave" Margin="10" Click="btnSave_Click">SAVE</Button>
            <Button x:Name="btnClear" Margin="10" Click="btnClear_Click">CLEAR / CANCEL</Button>
        </StackPanel>
    </Grid>
</UserControl>
