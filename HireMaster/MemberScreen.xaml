<UserControl x:Class="HireMaster.MemberScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HireMaster"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" d:Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="6*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="dgvMembers" Margin="10" CanUserAddRows="False" SelectionChanged="dgvMembers_SelectionChanged"/>

        <Button x:Name="btnDelete" Grid.Row="1" HorizontalAlignment="Left" Margin="10" Width="100" Click="btnDelete_Click">EDIT</Button>

        <StackPanel Grid.Column="1" Margin="10">
            <Label>First Name</Label>
            <TextBox x:Name="txtFirstName"/>
            <Label>Last Name</Label>
            <TextBox x:Name="txtlastName"/>
            <Label>Phone</Label>
            <TextBox x:Name="txtPhone"/>
            <Label>Email</Label>
            <TextBox x:Name="txtEmail"/>
            <Button x:Name="btnSave" Margin="10" Click="btnSave_Click">SAVE</Button>
            <Button x:Name="btnClear" Margin="10" Click="btnClear_Click">CLEAR / CANCEL</Button>
        </StackPanel>
    </Grid>
</UserControl>
